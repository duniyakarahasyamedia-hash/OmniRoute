# RAHASYA n8n installer configuration.
# Copy this file to .env in this directory. Never commit the populated .env.

# n8n public API. The API key needs workflow read, create, update, and publish access.
N8N_BASE_URL=https://n8n.example.com
N8N_API_KEY=
# Optional n8n project that will own all 19 workflows.
N8N_PROJECT_ID=

# Service URLs as reachable FROM n8n (use Docker service DNS on a shared network).
OMNIROUTE_BASE_URL=http://omniroute:20128
MONEYPRINTER_BASE_URL=http://moneyprinter:8080

# OmniRoute catalog IDs or operator-defined aliases.
# They must resolve to configured chat/image models.
OMNIROUTE_MODEL=auto
OMNIROUTE_IMAGE_MODEL=image

# Existing n8n credential IDs and their exact display names.
RAHASYA_OMNIROUTE_CREDENTIAL_ID=
RAHASYA_OMNIROUTE_CREDENTIAL_NAME=RAHASYA OmniRoute Bearer
RAHASYA_POSTGRES_CREDENTIAL_ID=
RAHASYA_POSTGRES_CREDENTIAL_NAME=RAHASYA Production PostgreSQL
RAHASYA_YOUTUBE_CREDENTIAL_ID=
RAHASYA_YOUTUBE_CREDENTIAL_NAME=RAHASYA YouTube OAuth2
# Immutable publication/analytics safety pin: the 24-character ID beginning with UC,
# not @RahasyaGlobal.
YOUTUBE_CHANNEL_ID=
RAHASYA_APPROVAL_BASIC_CREDENTIAL_ID=
RAHASYA_APPROVAL_BASIC_CREDENTIAL_NAME=RAHASYA Authorized Reviewers

# Used only by deploy.py or the documented psql migration command; never written to n8n.
RAHASYA_DATABASE_URL=
# Optional PostgreSQL client executable name or absolute path used by deploy.py.
PSQL_BIN=psql
