# ============================================================
#  YouTube Autopilot — API Keys (.env file me ye copy karke bharo)
#  NOTE: Ye file kabhi git me commit mat karna (already ignored)
# ============================================================

# --- Story Engine ---
# OpenAI key (ya OmniRoute gateway key):
OPENAI_API_KEY=
OPENAI_BASE_URL=          # optional — OmniRoute gateway URL yahan daalein

# --- Voiceover (full quality) ---
ELEVENLABS_API_KEY=
# ElevenLabs voice id — config.yaml me voice.voice_id me bhi daalna hoga

# --- Images (agar replicate use karein) ---
REPLICATE_API_KEY=

# --- YouTube ---
# 'python -m autopilot auth' chalane ke baad ye auto-fill hota hai:
YOUTUBE_REFRESH_TOKEN=

# --- Dashboard ---
DASHBOARD_TOKEN=change-me
