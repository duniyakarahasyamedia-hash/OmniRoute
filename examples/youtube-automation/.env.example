# ── yt-auto config ─ copy to .env and fill in ──────────────────────────────
# OmniRoute endpoint (Dashboard: http://localhost:20128)
OMNIROUTE_URL=http://localhost:20128/v1

# Copy from OmniRoute Dashboard → Endpoints
OMNIROUTE_KEY=

# Models ("auto" = OmniRoute smart-routes to the best connected provider)
YT_MODEL=auto
YT_FAST_MODEL=auto
YT_IMAGE_MODEL=auto

# Voiceover (needs Gemini API key connected, or another TTS provider)
YT_TTS_MODEL=gemini/gemini-3.1-flash-tts-preview
YT_VOICE=Kore

# Content: language (hinglish | hi | en) and your channel niche
YT_LANG=hinglish
YT_NICHE=general

# Where output goes (default: ./output)
# YT_OUT_DIR=./output
