# ============================================================
#  Copy this file to .env and fill in your keys.
#  EVERYTHING here is optional — the pipeline works without keys
#  (template mode + gradient backgrounds + silent/manual TTS check).
# ============================================================

# ---- OmniRoute (AI gateway) ----
# Default: OmniRoute local API (dashboard port). Leave as-is if OmniRoute runs locally.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto

# Or point directly at any OpenAI-compatible provider:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ---- Stock footage (free keys) ----
# Get: https://www.pexels.com/api/  (200 req/month free)
PEXELS_API_KEY=
# Get: https://pixabay.com/api/docs/ (100 req/min free)
PIXABAY_API_KEY=

# ---- TTS ----
# edge = free Microsoft Edge TTS (default, no key needed, best Hindi voices)
# gtts = Google Translate TTS (free fallback)
# openai = needs OPENAI_API_KEY above
TTS_BACKEND=edge
TTS_VOICE=hi-IN-MadhurNeural

# ---- YouTube upload ----
# OAuth2 credentials JSON from Google Cloud Console (see README section "YouTube setup")
YT_CLIENT_SECRETS=credentials/client_secrets.json
YT_TOKEN_FILE=credentials/token.json

# ---- Misc ----
# Path to ffmpeg binary (default: bundled imageio-ffmpeg)
FFMPEG_PATH=
OUTPUT_DIR=output
LOG_LEVEL=INFO
