{
  "name": "OmniRoute Shorts — Daily Automation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 10,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Daily 10:00",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1.1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8899/make",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"topic\": \"\",\n  \"no_upload\": false\n}",
        "options": {
          "timeout": 1200000
        }
      },
      "id": "http-trigger",
      "name": "Trigger pipeline (webhook)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "={{ $json.ok }}",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.ok }}",
              "rightValue": "=true",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "if-success",
      "name": "Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [400, 0]
    },
    {
      "parameters": {
        "url": "http://localhost:8899/health"
      },
      "id": "notify",
      "name": "Notify (health check)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [600, -100]
    }
  ],
  "connections": {
    "Daily 10:00": {
      "main": [
        [
          {
            "node": "Trigger pipeline (webhook)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger pipeline (webhook)": {
      "main": [
        [
          {
            "node": "Success?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
